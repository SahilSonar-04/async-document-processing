DATABASE_URL=postgresql+asyncpg://docflow:docflow_secret@postgres:5432/docflow_db
SYNC_DATABASE_URL=postgresql+psycopg2://docflow:docflow_secret@postgres:5432/docflow_db

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

SECRET_KEY=change_me_before_running

ENVIRONMENT=development
UPLOAD_DIR=/app/uploads

CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

SSE_MODE=pubsub

GEMINI_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.1-flash-lite
LLM_REQUEST_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=1024
LLM_MAX_INPUT_CHARACTERS=60000
